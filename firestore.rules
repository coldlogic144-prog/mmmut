rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ============================================================
    // USERS COLLECTION: User profile documents
    // Path: /users/{uid}
    // ============================================================
    match /users/{uid} {
      // Any authenticated user can read profiles (needed for dashboard, leaderboard, community)
      allow read: if isSignedIn();

      // SIGNUP FIX: An authenticated user can create their own profile during signup.
      // Must be signed in, and document ID must match the authenticated UID.
      allow create: if isOwner(uid);

      // A user can update their own profile, or an admin can update it
      allow update: if isOwner(uid) || isAdmin();

      // Only admins can delete user profiles
      allow delete: if isAdmin();

      // Push notification tokens subcollection
      match /notificationTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ============================================================
    // ATTENDANCE: User attendance data
    // Path: /attendance/{uid}
    // ============================================================
    match /attendance/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ============================================================
    // OTHER APP COLLECTIONS
    // ============================================================
    match /adminRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /eventOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timetableOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /feedback/{id} {
      allow read, write: if isSignedIn();
    }

    match /ratings/{id} {
      allow read, write: if isSignedIn();
    }

    match /communityPosts/{id} {
      allow read, write: if isSignedIn();
    }

    match /chessClubMembers/{uid} {
      allow read, write: if isSignedIn();
    }

    match /chessChallenges/{id} {
      allow read, write: if isSignedIn();
    }

    match /chessEvents/{id} {
      allow read, write: if isSignedIn();
    }

    match /chessActivity/{id} {
      allow read, write: if isSignedIn();
    }

    match /chessGames/{id} {
      allow read, write: if isSignedIn();
    }

    match /studentRoster/{roll} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /userRolls/{roll} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
