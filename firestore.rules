rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Privileged fields that owners may never self-write.
    function noPrivilegedEscalation() {
      return !request.resource.data.keys().hasAny(
        ['isAdmin', 'rollNumberVerified', 'migrationStatus', 'rollNumber', 'migrationReviewReason', 'rollClaimedAt']
      ) || isAdmin();
    }

    // ============================================================
    // USERS COLLECTION: User profile documents
    // Path: /users/{uid}
    // ============================================================
    match /users/{uid} {
      // Any authenticated user can read profiles (needed for dashboard, leaderboard, community)
      allow read: if isSignedIn();

      // SIGNUP FIX: An authenticated user can create their own profile during signup.
      // Must be signed in, document ID must match UID, and privileged flags
      // can never be set at creation (isAdmin always false on create).
      allow create: if isOwner(uid)
        && request.resource.data.username is string
        && (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false)
        && (!request.resource.data.keys().hasAny(['rollNumberVerified']) || request.resource.data.rollNumberVerified == false);

      // Owner may update only safe profile fields; privileged fields need admin.
      // Admins may update anything (roll verification workflow).
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == null
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(
          ['name', 'branchId', 'section', 'hostel', 'gender', 'adminRequested',
           'pendingRollNumber', 'lastReadPosts', 'updatedAt']
        )
      );

      // Only admins can delete user profiles
      allow delete: if isAdmin();

      // Push notification tokens subcollection
      match /notificationTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      // Ledger syllabus progress subcollection
      match /ledgerProgress/{branch} {
        allow read, write: if isOwner(uid);
      }
    }

    // ============================================================
    // ATTENDANCE: User attendance data
    // Path: /attendance/{uid}
    // ============================================================
    match /attendance/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ============================================================
    // TELEGRAM APPLICATIONS: Private Telegram Access System
    // Path: /telegramApplications/{uid}
    // ============================================================
    match /telegramApplications/{uid} {
      // Owner can read their own application; Admins can read all applications
      allow read: if isOwner(uid) || isAdmin();

      // Owner can submit an initial application with PENDING_ADMIN_APPROVAL
      allow create: if isOwner(uid) &&
                    request.resource.data.uid == uid &&
                    request.resource.data.status == 'PENDING_ADMIN_APPROVAL';

      // Updates:
      // - Admins can update any field (approving/rejecting, setting review notes)
      // - Owners can update only their own document, and CANNOT self-approve (cannot set ADMIN_APPROVED)
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == uid &&
        (
          (resource.data.status == 'ADMIN_REJECTED' && request.resource.data.status == 'PENDING_ADMIN_APPROVAL') ||
          (
            request.resource.data.status != 'ADMIN_APPROVED' &&
            request.resource.data.status != 'ADMIN_REJECTED' &&
            (resource.data.status in ['ADMIN_APPROVED', 'JOIN_REQUEST_NOT_SENT', 'JOIN_REQUEST_PENDING', 'CHANNEL_APPROVED'])
          )
        )
      );

      // Only admins can delete applications
      allow delete: if isAdmin();
    }

    // ============================================================
    // OTHER APP COLLECTIONS
    // ============================================================
    // Admin requests: any signed-in user may create their own pending request;
    // only admins may read all / update / delete. Client queries by uid are
    // still allowed via owner check on document data.
    match /adminRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /eventOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /timetableOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Feedback: owner create, owner read own, admin read all, admin reply/status,
    // owner delete only while open.
    match /feedback/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == resource.data.status
        && !request.resource.data.keys().hasAny(['adminReply', 'adminReplyAt', 'repliedBy', 'status'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'open'
      );
    }

    // Ratings: one doc per user; owner-only write with uid match.
    match /ratings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Community posts: admin-only create/delete; any signed-in may read;
    // likes array may be updated by any signed-in user but nothing else.
    match /communityPosts/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes'])
      );
    }

    match /chessClubMembers/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Chess challenges: participants or admin only.
    match /chessChallenges/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.fromUid == request.auth.uid
            || request.resource.data.toUid == request.auth.uid);
      allow update: if isAdmin()
        || (isSignedIn() && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid));
      allow delete: if isAdmin()
        || (isSignedIn() && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid));
    }

    match /chessEvents/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Chess activity/games: signed-in may create own entries; only author/admin may modify.
    match /chessActivity/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /chessGames/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /studentRoster/{roll} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Roll claims: public readability retained for verification UX, but claims
    // are create-only and immutable (no overwrite/steal).
    match /userRolls/{roll} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rollNumber == roll;
      allow update, delete: if false;
    }
  }
}
