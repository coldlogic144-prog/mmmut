rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isOwnerFile(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Community post images: path communityPosts/{uid}/{file}. Owner-only write.
    match /communityPosts/{uid}/{file} {
      allow read: if isSignedIn();
      allow write: if isOwnerFile(uid) && isImage();
    }
    // Feedback attachments: path feedback/{uid}/{file}. Owner-only write.
    match /feedback/{uid}/{file} {
      allow read: if isSignedIn();
      allow write: if isOwnerFile(uid) && isImage();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
