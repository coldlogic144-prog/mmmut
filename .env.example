# Copy to .env (never commit real values). Used by the Flask backend only.
# The frontend needs NO secrets — Firebase web keys are public by design.

# Comma-separated CORS origins allowed to call the API.
API_ALLOW_ORIGIN=https://coldlogic144-prog.github.io

# Where the roster CSV lives (defaults to ../data/admission_data.csv).
MMMUT_DATA_CSV=data/admission_data.csv

PORT=5000

# ============================================================================
# PRIVATE TELEGRAM ACCESS SYSTEM (Server-side environment variables)
# ============================================================================

# 1. Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# 2. Telegram Bot Username without @ (e.g. mmmut_erp_bot)
TELEGRAM_BOT_USERNAME=mmmut_erp_bot

# 3. Telegram Private Channel ID (e.g. -1001234567890)
# Obtain this by adding @RawDataBot or @userinfobot to the channel, or from web.telegram.org
TELEGRAM_CHANNEL_ID=

# 4. Secret token for authenticating webhook calls from Telegram
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in production: webhook returns 503 until this is set.
TELEGRAM_WEBHOOK_SECRET=

# 5. Optional static private channel invite link requiring admin approval
# If left empty, the bot will dynamically generate one using createChatInviteLink(creates_join_request=True)
# NEVER commit a real invite link here. Set it only in the host env.
TELEGRAM_CHANNEL_INVITE_LINK=

# Webhook allowlist (comma-separated origins allowed to be registered via set-webhook).
TELEGRAM_WEBHOOK_ALLOWLIST=https://mmmut-ero-backend.onrender.com

# Dev-only Telegram simulate endpoints. Keep false/empty in production.
ENABLE_TELEGRAM_SIMULATE=false
FLASK_ENV=production

# 6. Firebase API Key & Project ID for verifying client ID tokens (defaults to student-erp-77605)
FIREBASE_API_KEY=AIzaSyDMLvLIZkPFO5nsVQBr2IA-8BRB5Hzb3Xo
FIREBASE_PROJECT_ID=student-erp-77605
